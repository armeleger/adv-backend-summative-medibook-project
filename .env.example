# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medibook

# Redis connection (waitlist queue + background jobs)
REDIS_URL=redis://127.0.0.1:6379

# Clinic timezone. Appointment times are stored as clinic wall-clock time,
# so the API server and the worker must run in the clinic's timezone.
TZ=Africa/Kigali

# Optional: where the audit log is written (defaults to logs/audit.log)
# AUDIT_LOG_FILE=logs/audit.log
